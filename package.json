{
  "name": "ancs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "secrets:check": "node scripts/check-secrets.mjs",
    "spec:check": "node scripts/spec-check.mjs",
    "arch:check": "pnpm --filter @ancs/arch-check run check",
    "test:unit": "vitest run --project unit",
    "test:eval": "vitest run --project eval",
    "test:playback-sync": "node scripts/playback-sync/measure.mjs",
    "test:contract": "node scripts/planned-suite.mjs test:contract P03-07 \"Provider Adapter 契约测试与 Mock 故障矩阵\"",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node scripts/planned-suite.mjs test:e2e P05-P08 \"创建项目→导入→叙事→分镜→编辑→预览→mock 终渲染→历史恢复\"",
    "test:security": "vitest run --project security",
    "test:render": "vitest run --project render",
    "test:golden": "vitest run --project golden",
    "test:provider-smoke": "node scripts/provider-smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "clean": "pnpm -r run clean",
    "test:web": "vitest run --project web",
    "provider:verify": "node scripts/provider-verify.mjs",
    "test:motion": "vitest run --project motion",
    "deploy:rehearsal": "node scripts/deploy-rehearsal.mjs",
    "recovery:rehearsal": "node scripts/recovery-rehearsal.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "launch:gate": "node scripts/launch-gate-check.mjs",
    "visual:qf": "node scripts/quiet-frame-visual.mjs",
    "visual:qf:responsive": "node scripts/quiet-frame-responsive-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "playwright": "1.61.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
