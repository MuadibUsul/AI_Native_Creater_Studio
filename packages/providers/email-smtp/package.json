{
  "name": "@ancs/providers-email-smtp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ancs/contracts": "workspace:*",
    "nodemailer": "10.0.15"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/smtp-server": "3.5.13",
    "smtp-server": "3.19.17",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
