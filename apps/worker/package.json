{
  "name": "@ancs/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --experimental-strip-types src/main.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ancs/contracts": "workspace:*",
    "@ancs/db": "workspace:*",
    "@ancs/domain": "workspace:*",
    "@ancs/providers-credential-vault-local": "workspace:*",
    "@ancs/providers-mock-provider": "workspace:*",
    "@ancs/providers-queue-bullmq": "workspace:*",
    "@ancs/providers-storage-local": "workspace:*",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "6.0.3",
    "@ancs/providers-mock-llm": "workspace:*",
    "@ancs/providers-mock-tts": "workspace:*",
    "@remotion/media-parser": "4.0.532"
  }
}
