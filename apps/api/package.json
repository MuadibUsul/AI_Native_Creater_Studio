{
  "name": "@ancs/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ancs/auth": "workspace:*",
    "@ancs/contracts": "workspace:*",
    "@ancs/db": "workspace:*",
    "@ancs/domain": "workspace:*",
    "@fastify/swagger": "9.9.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ancs/sdk": "workspace:*",
    "@types/node": "26.6.4",
    "typescript": "6.0.3"
  }
}
