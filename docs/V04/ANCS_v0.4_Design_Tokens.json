  "prohibitions": [
    "gradients outside ui.ai.* identity uses and the canvas dot grid (see surfaces.aiAccent)",
    "neon on regular controls",
    "background blur outside floating chrome (see surfaces.glass)",
    "rainbow AI waveform",
    "continuous decorative motion (shimmer only while AI works; aurora is static)",
    "colored cards, KPIs or charts",
    "global grayscale/invert/brightness",
    "using subtle borders as sole boundary of fields, toggles or icon-only buttons"
  ],
  "contentExceptions": [
    "original media",
    "cover art",
    "user content branding",
    "color tools",
    "explicit per-clip labels",
    "OS forced-colors accessibility"
  ],
  "notes": [
    "Static color checks are not browser/component/WCAG conformance validation.",
    "Integrate appearance initialization and persistence in the existing app.",
    "Only open-licensed font files may be bundled (Google Sans is OFL 1.1)."
  ],
  "revisions": [
    {
      "date": "2026-10-14",
      "change": "UI refresh: deeper dark layering (subtle/elevated/hover/border/selection), primary hover token, elevation, easing, mono font and pill radius; see docs/design/ui-refresh-2026-10.md"
    },
    {
      "date": "2026-10-15",
      "change": "ANCS Canvas (ADR 0019): Stitch-style dark-first palette with Google-grey neutrals, AI accent colours, glass and dot-grid surfaces, pill buttons, larger radii, Google Sans (OFL); see docs/design/stitch-redesign-2026-10.md"
    }
  ],
  "fontFiles": {
    "family": "Google Sans",
    "license": "SIL Open Font License 1.1 (googlefonts/googlesans)",
    "path": "apps/web/public/fonts/google-sans/",
    "subsets": [
      "latin",
      "latin-ext"
    ],
    "weights": "variable 400–700",
    "cjk": "system fallback (not bundled)"
  },
  "surfaces": {
    "canvas": "Dot grid on ui.bg.canvas: 1px dots every 20px (dark rgba(255,255,255,.075), light rgba(32,33,36,.10)). App backgrounds only; never behind body text blocks without an elevated surface.",
    "glass": {
      "dark": {
        "bg": "rgba(30, 31, 34, .72)",
        "border": "rgba(232, 234, 237, .12)"
      },
      "light": {
        "bg": "rgba(255, 255, 255, .78)",
        "border": "rgba(31, 31, 31, .08)"
      },
      "filter": "blur(24px) saturate(150%)",
      "rule": "Only for chrome floating over the canvas or media (top bar, tool rail, voice pill, floating timeline, dialog scrim). Content cards stay solid."
    },
    "aiAccent": {
      "gradient": "90deg ui.ai.blue → ui.ai.violet → ui.ai.teal",
      "rule": "AI identity only: ✦ mark, AI-working shimmer/outline, main prompt focus glow, one static aurora behind the home hero. Never on regular buttons, cards, KPIs, charts or body text; shimmer only while AI is working; reduced motion removes it."
    }
  }
