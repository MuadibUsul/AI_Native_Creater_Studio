      "deviceOverride",
      "userPreference",
      "system",
      "lightFallback"
    ],
    "doesNotChange": "ProjectDocument, media pixels, content theme, selections, billing"
  },
  "themes": {
    "light": {
      "ui.bg.canvas": "#FFFFFF",
      "ui.bg.subtle": "#F5F5F5",
      "ui.bg.elevated": "#FFFFFF",
      "ui.bg.hover": "#EFEFEF",
      "ui.fg.primary": "#171717",
      "ui.fg.secondary": "#595959",
      "ui.fg.muted": "#666666",
      "ui.border.subtle": "#E5E5E5",
      "ui.border.control": "#737373",
      "ui.action.primary.bg": "#171717",
      "ui.action.primary.fg": "#FFFFFF",
      "ui.action.primary.hover": "#383838",
      "ui.selection.bg": "#E8E8E8",
      "ui.focus.ring": "#171717",
      "ui.media.matte": "#0A0A0A"
    },
    "dark": {
      "ui.bg.canvas": "#0A0A0A",
      "ui.bg.subtle": "#111111",
      "ui.bg.elevated": "#171717",
      "ui.bg.hover": "#222222",
      "ui.fg.primary": "#EDEDED",
      "ui.fg.secondary": "#B3B3B3",
      "ui.fg.muted": "#A3A3A3",
      "ui.border.subtle": "#262626",
