      "ui.ai.violet": "#7C4DFF",
      "ui.ai.teal": "#00897B"
    },
    "dark": {
      "ui.bg.canvas": "#0E0E10",
      "ui.bg.subtle": "#151517",
      "ui.bg.elevated": "#1E1F22",
      "ui.bg.hover": "#2A2B2F",
      "ui.fg.primary": "#F1F3F4",
      "ui.fg.secondary": "#BDC1C6",
      "ui.fg.muted": "#9AA0A6",
      "ui.border.subtle": "#2D2E31",
      "ui.border.control": "#80868B",
      "ui.action.primary.bg": "#F1F3F4",
      "ui.action.primary.fg": "#202124",
      "ui.action.primary.hover": "#FFFFFF",
      "ui.selection.bg": "#303134",
      "ui.focus.ring": "#F1F3F4",
      "ui.media.matte": "#0A0A0A",
      "ui.ai.blue": "#7CACF8",
      "ui.ai.violet": "#A78BFA",
      "ui.ai.teal": "#5ED3E0"
