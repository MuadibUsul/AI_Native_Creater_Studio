  "motionMs": {
    "feedback": [
      100,
      150
    ],
    "popover": [
      120,
      180
    ],
    "drawer": [
      180,
      220
    ]
  },
  "motionEasing": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
    "exit": "cubic-bezier(0.4, 0, 1, 1)",
    "rule": "Feedback uses standard; overlays enter with enter and leave with exit; reduced motion keeps opacity/colour changes and drops transforms."
  },
  "elevation": {
    "light": {
      "1": "0 1px 2px rgba(0, 0, 0, .06)",
      "2": "0 1px 2px rgba(0, 0, 0, .04), 0 4px 12px rgba(0, 0, 0, .06)",
      "3": "0 2px 8px rgba(0, 0, 0, .06), 0 16px 40px rgba(0, 0, 0, .14)"
    },
    "dark": {
      "1": "0 1px 2px rgba(0, 0, 0, .5)",
      "2": "inset 0 1px 0 rgba(255, 255, 255, .04), 0 1px 2px rgba(0, 0, 0, .5), 0 4px 12px rgba(0, 0, 0, .35)",
      "3": "inset 0 1px 0 rgba(255, 255, 255, .05), 0 2px 8px rgba(0, 0, 0, .5), 0 16px 48px rgba(0, 0, 0, .55)"
    },
    "rule": "1 = resting controls and cards, 2 = raised/selected items and the media frame, 3 = popovers, drawers and dialogs. Neutral black only; elevation never replaces a 3:1 control boundary."
  },
