  "name": "ANCS Monochrome",
  "status": "IMPLEMENTATION_REFERENCE_NOT_INTEGRATED",
  "source": "ANCS_AI_Native_v0.4.md §29; user-selected aesthetic, not Apple proprietary tokens",
  "appearance": {
