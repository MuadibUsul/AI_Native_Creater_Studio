      "ui.media.matte": "#0A0A0A"
    }
  },
  "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
  "fontFamilyMono": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
  "fontFilesIncluded": false,
  "spacingPx": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
