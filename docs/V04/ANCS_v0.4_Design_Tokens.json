  "fontFamily": "\"Google Sans\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
  "fontFamilyMono": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
  "fontFilesIncluded": true,
  "spacingPx": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radiiPx": {
    "smallControl": 10,
    "control": 12,
    "field": 14,
    "overlay": 20,
    "container": 28,
    "pill": 999,
    "button": "pill"
  },
  "controlHeightPx": {
    "default": 40,
    "compactDesktop": 32,
    "touchTargetMinimum": 44
  },
  "tableRowHeightPx": {
    "comfortable": 48,
    "compact": 36
  },
  "typography": {
    "pageTitle": {
      "sizePx": 32,
      "lineHeightPx": 40,
      "weight": 400,
      "trackingEm": -0.02
    },
    "smallScreenTitle": {
      "sizePx": 26,
      "lineHeightPx": 32,
      "weight": 400
    },
    "sectionTitle": {
      "sizePx": 18,
      "lineHeightPx": 26,
      "weight": 500
    },
    "body": {
      "sizePx": 16,
      "lineHeightPx": 24,
      "weight": 400
    },
    "control": {
      "sizePx": 14,
      "lineHeightPx": 20,
      "weight": 500
    },
    "metadata": {
      "sizePx": 12,
      "lineHeightPx": 18,
      "weight": 400
    },
    "metric": {
      "sizePx": 24,
      "lineHeightPx": 32,
      "weight": 600
    },
    "display": {
      "sizePx": "clamp(40, 5.2vw, 72)",
      "lineHeight": 1.08,
      "weight": 400,
      "trackingEm": -0.03
    }
  },
  "motionMs": {
    "feedback": [
      100,
      150
    ],
    "popover": [
      120,
      180
    ],
    "drawer": [
      180,
      220
    ]
  },
  "motionEasing": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
    "exit": "cubic-bezier(0.4, 0, 1, 1)",
    "rule": "Feedback uses standard; overlays enter with enter and leave with exit; reduced motion keeps opacity/colour changes and drops transforms."
  },
  "elevation": {
    "light": {
      "1": "0 1px 2px rgba(60, 64, 67, .08)",
      "2": "0 1px 2px rgba(60, 64, 67, .08), 0 4px 16px rgba(60, 64, 67, .08)",
      "3": "0 4px 12px rgba(60, 64, 67, .10), 0 24px 56px rgba(60, 64, 67, .18)"
    },
    "dark": {
      "1": "inset 0 0 0 1px rgba(255, 255, 255, .06)",
      "2": "inset 0 1px 0 rgba(255, 255, 255, .06), 0 2px 6px rgba(0, 0, 0, .4), 0 8px 24px rgba(0, 0, 0, .35)",
      "3": "inset 0 1px 0 rgba(255, 255, 255, .07), 0 8px 24px rgba(0, 0, 0, .5), 0 24px 64px rgba(0, 0, 0, .55)"
    },
    "rule": "1 = resting controls and cards, 2 = raised/selected items and the media frame, 3 = popovers, drawers and dialogs. Neutral black only; elevation never replaces a 3:1 control boundary."
  },
