# 环境示例（规范 §50）：.env 只存基础 Secret / 连接信息。
# Provider 模型路由、价格、并发策略等一律走版本化配置（Provider Catalog），不写在这里。
# 复制为 .env 后填写本地值；禁止把真实 Secret 提交进仓库。

# 数据库（本地开发由 infra/docker-compose.dev.yml 提供，端口 55432）
DATABASE_URL=postgres://ancs:ancs@localhost:55432/ancs_dev

# 队列
REDIS_URL=redis://localhost:6379

# 对象存储（S3 接口；本地可用兼容服务，如 MinIO）
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=ap-northeast-1
OBJECT_STORAGE_BUCKET=ancs-dev
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# 凭据加密（生产必须使用真实 KMS；开发实现需明确标识）
KMS_KEY_ID=

# 供应商凭据信封加密密钥：v1:<base64 32 字节>[,v2:<...>]
# 生产**必填**（缺失即启动失败）：不得与会话密钥共用一把；轮换只需追加新版本。
ANCS_CREDENTIAL_KEYS=

# 认证（P01-02）：会话/令牌签名密钥（生产经 KMS/Secrets 注入；禁止写入仓库）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# 原生客户端注册（JSON 数组：[{ "clientId": "...", "redirectUris": ["ancs://auth/callback"] }]）
ANCS_NATIVE_CLIENTS=

# 独立运营会话（N15-02）：生产 NODE_ENV=production 时必须显式设 PRODUCTION。
# 历史 ANCS_PLATFORM_ADMINS 白名单已不授予任何运营权限；principal/role grant 由数据库治理。
ANCS_OPS_ENVIRONMENT=DEVELOPMENT
ANCS_OPS_IDLE_SECONDS=900
ANCS_OPS_ABSOLUTE_SECONDS=28800
ANCS_OPS_REAUTH_SECONDS=300

# 生产进程（NODE_ENV=production）装配 Mock/脚本化驱动的显式许可（V5-M3）：留空 = 不允许，启动失败
ANCS_ALLOW_MOCK_PROVIDERS=

# Edge（V5-M4）：浏览器来源白名单（逗号分隔完整 origin；留空 = BETTER_AUTH_URL 的 origin + 本地 Web 端口）
ANCS_ALLOWED_ORIGINS=
# 前置可信代理跳数（0 = 不信任 X-Forwarded-For）；限流开关 enforce | off（生产不得 off）
ANCS_TRUST_PROXY_HOPS=0
ANCS_RATE_LIMIT=enforce
# Web 构建期：CSP 额外放行的媒体/上传来源（签名 URL 直达的存储或 API origin）
ANCS_CSP_EXTRA_ORIGINS=

# 平台托管 Provider 凭据（格式 供应商:密钥,供应商:密钥；仅后端使用，绝不进入客户端）
ANCS_PLATFORM_PROVIDER_KEYS=

# 可选：Remotion 渲染使用的浏览器可执行文件路径（留空则自动检测本机 Chrome，否则下载 Headless Shell）
REMOTION_BROWSER_EXECUTABLE=

# V6-3 特效（Worker）：AI 当场写特效代码 disabled（缺省，只用模板库）| enabled（按评测结果开启；代码先过四道门禁）
ANCS_EFFECT_CODEGEN=
# 可选：特效图层渲染命令覆盖（缺省为仓库内 apps/render-worker/src/run-effect.ts）
ANCS_EFFECT_RENDER_CMD=

# V6-6 从参考视频学风格（Worker）：平台页面链接（如 YouTube 视频页）的下载命令，必须含 {url} 与 {output}；
# 留空时只支持上传文件与直接的视频文件链接（页面链接明确失败并提示下载后上传）。例：
# ANCS_REFERENCE_FETCH_CMD=yt-dlp --no-playlist -f mp4/bestvideo*+bestaudio/best -o {output} {url}
ANCS_REFERENCE_FETCH_CMD=
# 可选：单条参考视频下载上限（MB，缺省 1024）
ANCS_REFERENCE_MAX_MB=

# V6-5 讲述配音（Worker）：flite = FFmpeg 内置本地英文语音（无需密钥，音质基础，FFmpeg 需带 libflite）；
# process = 你接入的语音合成程序（任意供应商）：每句启动一次，stdin 一行 JSON {"text","voice","speed"}，stdout 输出音频。
# 留空 = 不装配，讲述工具明确报"没有配置配音"。
ANCS_NARRATION_DRIVER=
ANCS_NARRATION_EXECUTABLE=
# 可选：传给程序的参数（字符串数组 JSON）
ANCS_NARRATION_ARGS_JSON=
# process / fish 驱动必填：声音列表与各自会说的语言，例如 [{"id":"zh-female-1","name":"晓晓","languages":["zh"],"description":"温和女声"}]
# （fish 驱动时 id 填 Fish Audio 的声音模型 id）
ANCS_NARRATION_VOICES_JSON=
# fish = Fish Audio（https://fish.audio，多语言）：密钥放在部署平台的密钥管理里，不要写进仓库或聊天
FISH_AUDIO_API_KEY=
# 可选：Fish Audio TTS 模型（缺省 s1）
ANCS_FISH_AUDIO_MODEL=
# gemini = Gemini TTS（预置声音，中英等多语言；用上面的 GEMINI_API_KEY；声音列表可用 ANCS_NARRATION_VOICES_JSON 覆盖，id 为小写声音名如 kore）
# 可选：Gemini 语音合成模型（缺省 gemini-3.8-flash-lite-tts；免费层每个 TTS 模型每天只有 10 次请求）
ANCS_GEMINI_TTS_MODEL=

# V6-7 数字人出镜（Worker）：heygen = HeyGen 会说话的照片 + Fish Audio 用你的声音读讲稿（两把密钥都要）
ANCS_AVATAR_DRIVER=
HEYGEN_API_KEY=
# 可选：数字人报价依据（缺省 V6 §10.1 规划区间 $2–6/分钟），例如
# {"kind":"AVATAR_CLIP","providerId":"heygen","implementation":"REAL","model":"heygen-talking-photo","perSecondMicros":{"min":33334,"max":100000},"maxSeconds":30,"languages":["en","zh"]}
ANCS_AVATAR_OFFER_JSON=

# V6-8 视频生成（Worker）：process = 你接入的生成程序（协议见 scripts/generation-process-example.mjs）
ANCS_GENERATION_DRIVER=
ANCS_GENERATION_EXECUTABLE=
ANCS_GENERATION_ARGS_JSON=
# 每类生成的报价依据（JSON 数组），例如 [{"kind":"VIDEO_SHOT","providerId":"vendor","implementation":"REAL","model":"…","perSecondMicros":{"min":50000,"max":400000},"maxSeconds":8}]
ANCS_GENERATION_OFFERS_JSON=
# 传给生成程序的额外环境变量名（逗号分隔，例如供应商密钥变量名）；子进程只拿到白名单 + 这些
ANCS_GENERATION_PASS_ENV=
ANCS_GENERATION_TIMEOUT_SECONDS=
# 生成镜头接 Google Veo（需 GEMINI_API_KEY；配置即启用，可与上面并存）。价格请按 Google 价格页填写（平台不内置），例如
# {"kind":"VIDEO_SHOT","providerId":"veo","implementation":"REAL","model":"veo-3.1-fast-generate-preview","perSecondMicros":{"min":<每秒微美元>,"max":<每秒微美元>},"maxSeconds":8,"durationOptions":[4,6,8]}
ANCS_VEO_OFFER_JSON=
# 生成镜头接火山方舟 Seedance（https://ark.cn-beijing.volces.com；配置即启用，可与上面并存）。方舟按 token 计价、人民币结算，
# 请按价格页换算成每秒美元微单位填写（平台不内置），例如
# {"kind":"VIDEO_SHOT","providerId":"seedance","implementation":"REAL","model":"doubao-seedance-2-5-260628","perSecondMicros":{"min":<每秒微美元>,"max":<每秒微美元>},"maxSeconds":10,"durationOptions":[5,10]}
ARK_API_KEY=
ANCS_SEEDANCE_OFFER_JSON=
# 可选：是否同时生成声音（缺省 1）、分辨率（如 720p）、方舟地址（缺省北京区域）
ANCS_SEEDANCE_GENERATE_AUDIO=
ANCS_SEEDANCE_RESOLUTION=
ANCS_ARK_BASE_URL=

# N05-01 实时语音会话短期凭证签名密钥（未配置时创建会话 501 fail-closed；不要放 Provider Key）
ANCS_VOICE_SESSION_SECRET=

# 真实语音识别（N05-02 起；批量适配器已核验，见 docs/verification/provider-real-deepgram.md）
# 仅后端使用；生产经 KMS/Secrets 注入，禁止入库、禁止下发客户端
# Worker ASR 驱动（V5-M3）：deepgram（需 DEEPGRAM_API_KEY）| process（需 ANCS_ASR_EXECUTABLE）；留空 = 不装配
ANCS_ASR_DRIVER=
DEEPGRAM_API_KEY=
# 真实大模型（规划与意图分类；适配器待接入）
DEEPSEEK_API_KEY=

# V6-1 通用导演 Agent（Worker；接入说明见 docs/V06/integration-checklist.md）
# anthropic = 真实 Claude（需 ANTHROPIC_API_KEY）；gemini = Google Gemini（需 GEMINI_API_KEY）；留空 = 不装配，AI 轮次明确失败 AGENT_MODEL_NOT_CONFIGURED
ANCS_AGENT_DRIVER=
ANTHROPIC_API_KEY=
# Google Gemini（https://ai.google.dev）：导演 / 镜头理解 / 讲述配音（driver=gemini）与 Veo 生成镜头（ANCS_VEO_OFFER_JSON）
GEMINI_API_KEY=
# 导演模型（缺省 anthropic: claude-opus-5-5；gemini: gemini-flash-latest）
ANCS_AGENT_MODEL=
# V6-1b 镜头理解：anthropic | gemini（同导演的密钥）| process（需 ANCS_VISUAL_ANALYSIS_EXECUTABLE）；留空 = 未配置
ANCS_VISUAL_ANALYSIS_DRIVER=
# 视觉理解模型（缺省 anthropic: claude-haiku-5-5；gemini: gemini-flash-lite-latest）
ANCS_VISION_MODEL=

# V6-2 Realtime Gateway（apps/realtime；与 API 共用上面的 ANCS_VOICE_SESSION_SECRET）
# deepgram = 真实流式识别（需 DEEPGRAM_API_KEY）；留空 = 不装配，开麦时明确提示"未配置"
ANCS_REALTIME_ASR_DRIVER=
# 流式模型（缺省：中文 nova-2，英文 nova-3）
ANCS_DEEPGRAM_LIVE_MODEL_ZH=
ANCS_DEEPGRAM_LIVE_MODEL_EN=
# Web 构建期：网关不与 Web 同源时的地址（wss://…/realtime/v1/voice；同时加进 ANCS_CSP_EXTRA_ORIGINS）
NEXT_PUBLIC_ANCS_REALTIME_URL=
