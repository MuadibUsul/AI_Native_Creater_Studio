    "GET /api/v1/workspaces/ws_visual_fixture/projects/prj_visual_01/narrative": {
      "schemaVersion": "1.0",
      "id": "np_visual_01",
      "revision": 2,
      "title": "当算力成为新资产",
      "thesis": "以可核对的商业问题审视算力投入。",
      "hook": "好作品，不只是把文章读一遍。它让复杂的问题，有一条可以跟随的线索。",
      "chapters": [
        {
          "id": "ch_visual_01",
          "title": "开场 · 一个好问题",
          "intent": null,
          "narrationBlockIds": [
            "nb_visual_01"
          ]
        },
        {
          "id": "ch_visual_02",
          "title": "从投入到产出",
          "intent": null,
          "narrationBlockIds": [
            "nb_visual_02",
            "nb_visual_03"
