# 生产环境变量样例（复制为 infra/production.env 后填写；该文件含密钥，禁止提交）。
# 生成随机值：openssl rand -base64 32
# 启动时一次性校验全部配置，缺一项都会拒绝启动并列出原因（docs/ops/deployment-runbook.md）。

NODE_ENV=production

# 数据库（compose 里的 db 服务；托管 PostgreSQL 16 时改成它的连接串）
POSTGRES_USER=ancs
POSTGRES_PASSWORD=
POSTGRES_DB=ancs
DATABASE_URL=postgres://ancs:<POSTGRES_PASSWORD>@db:5432/ancs

# 对外地址（浏览器访问的 Web 地址；签名、回调与来源白名单都以它为准）
BETTER_AUTH_URL=https://studio.example.com
ANCS_STORAGE_PUBLIC_BASE_URL=https://studio.example.com
ANCS_API_INTERNAL_URL=http://api:3001

# 三把互不相同的密钥（不得共用）
BETTER_AUTH_SECRET=
ANCS_STORAGE_SECRET=
ANCS_CREDENTIAL_KEYS=v1:
ANCS_VOICE_SESSION_SECRET=

# 运营环境标识（生产必须显式写 PRODUCTION）
ANCS_OPS_ENVIRONMENT=PRODUCTION

# 存储：local = 单机磁盘（API 与 Worker 共用同一个卷）；多机部署改用 s3（手册 §10.3：CORS、权限、Web 构建参数 ANCS_CSP_EXTRA_ORIGINS）
ANCS_STORAGE_DRIVER=local
ANCS_STORAGE_LOCAL_DIR=/data/storage
# ANCS_STORAGE_DRIVER=s3
# ANCS_S3_BUCKET=
# ANCS_S3_REGION=            # R2 写 auto
# ANCS_S3_ENDPOINT=          # 非 AWS 时填，如 https://<账号>.r2.cloudflarestorage.com
# ANCS_S3_ACCESS_KEY_ID=
# ANCS_S3_SECRET_ACCESS_KEY=

# 反向代理在前面时：信任的代理跳数（决定限流用的客户端 IP）
ANCS_TRUST_PROXY_HOPS=1

# 优雅退出：先标记不就绪并等负载均衡摘除，再停止接新请求
ANCS_SHUTDOWN_DRAIN_SECONDS=5
ANCS_SHUTDOWN_TIMEOUT_SECONDS=30

# 旧 V4 流水线（脚本 / 分镜 / 旧配音 / 声音克隆 / 素材搜索）只有测试替身，生产缺省不装配（off）：
# 相关端点 501，旧页面显示说明并引导到共看片室。不要在生产改成 mock（那还需要 ANCS_ALLOW_MOCK_PROVIDERS=1，产物是模板草稿）。
# ANCS_LEGACY_PIPELINE=off

# AI 导演与语音、生成供应商：见 docs/V06/integration-checklist.md（密钥只放在这里或密钥管理服务）

# AI 生成合成内容标识的服务提供者编码（写进成片 AIGC 元数据；面向中国境内公众时必须配置，手册 §5.6）
# ANCS_AIGC_PRODUCER_CODE=

# 多台 API 时：限流额度存在 Redis 里共用（不配则每个 API 进程各自限流）
# ANCS_RATE_LIMIT_REDIS_URL=redis://redis:6379
