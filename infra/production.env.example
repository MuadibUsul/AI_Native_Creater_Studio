# 生产环境变量样例（复制为 infra/production.env 后填写；该文件含密钥，禁止提交）。
# 生成随机值：openssl rand -base64 32
# 启动时一次性校验全部配置，缺一项都会拒绝启动并列出原因（docs/ops/deployment-runbook.md）。

NODE_ENV=production

# 数据库（compose 里的 db 服务；托管 PostgreSQL 16 时改成它的连接串）
POSTGRES_USER=ancs
POSTGRES_PASSWORD=
POSTGRES_DB=ancs
DATABASE_URL=postgres://ancs:<POSTGRES_PASSWORD>@db:5432/ancs

# 对外地址（浏览器访问的 Web 地址；签名、回调与来源白名单都以它为准）
BETTER_AUTH_URL=https://studio.example.com
ANCS_STORAGE_PUBLIC_BASE_URL=https://studio.example.com
ANCS_API_INTERNAL_URL=http://api:3001

# 三把互不相同的密钥（不得共用）
BETTER_AUTH_SECRET=
ANCS_STORAGE_SECRET=
ANCS_CREDENTIAL_KEYS=v1:
ANCS_VOICE_SESSION_SECRET=

# 运营环境标识（生产必须显式写 PRODUCTION）
ANCS_OPS_ENVIRONMENT=PRODUCTION

# 存储：local = 单机磁盘（API、Worker 与调度器共用同一个卷）；多机部署改用 s3（手册 §10.3：CORS、权限、Web 构建参数 ANCS_CSP_EXTRA_ORIGINS）
ANCS_STORAGE_DRIVER=local
ANCS_STORAGE_LOCAL_DIR=/data/storage
# ANCS_STORAGE_DRIVER=s3
# ANCS_S3_BUCKET=
# ANCS_S3_REGION=            # R2 写 auto
# ANCS_S3_ENDPOINT=          # 非 AWS 时填，如 https://<账号>.r2.cloudflarestorage.com
# ANCS_S3_ACCESS_KEY_ID=
# ANCS_S3_SECRET_ACCESS_KEY=

# 维护调度（scheduler 服务，I-10）：通知派发间隔（秒，10–3600）与每天保留清理的 UTC 时刻；缺省 60 与 03:30
# ANCS_SCHEDULE_DISPATCH_SECONDS=60
# ANCS_SCHEDULE_RETENTION_UTC=03:30
# 保留期（可选）：回收站保留天数、幂等键保留小时数；缺省 30 天与 24 小时
# ANCS_TRASH_RETENTION_DAYS=30
# ANCS_IDEMPOTENCY_TTL_HOURS=24

# 反向代理在前面时：信任的代理跳数（决定限流用的客户端 IP）
ANCS_TRUST_PROXY_HOPS=1

# 优雅退出：先标记不就绪并等负载均衡摘除，再停止接新请求
ANCS_SHUTDOWN_DRAIN_SECONDS=5
ANCS_SHUTDOWN_TIMEOUT_SECONDS=30

# 旧 V4 流水线（脚本 / 分镜 / 旧配音 / 声音克隆 / 素材搜索）只有测试替身，生产缺省不装配（off）：
# 相关端点 501，旧页面显示说明并引导到共看片室。不要在生产改成 mock（那还需要 ANCS_ALLOW_MOCK_PROVIDERS=1，产物是模板草稿）。
# ANCS_LEGACY_PIPELINE=off

# AI 导演与语音、生成供应商：见 docs/V06/integration-checklist.md（密钥只放在这里或密钥管理服务）

# 每个工作区每月 AI 模型费用上限（美元；导演对话、审片执行、自主制作、风格撰写合计；手册 §10.5）。生产必须配置。
# 套餐里设了 aiSpendMicrosPerMonth 的工作区以套餐为准；确实不设上限写 unlimited。API 与 Worker 读同一个值。
ANCS_AI_MONTHLY_CAP_USD=20
# 上限按美元计算，所以 Worker 用到的每个模型都要有单价。内置只有 Claude；DeepSeek（deepseek-v4-pro，带图时 deepseek-flash）、
# Elorian（elorian-1-agent）、Gemini 等要在这里按供应商价格页填写（美元/百万 token），否则这些模型不会被调用（手册 §10.5）。
# 占位符必须换成数字（不换会启动失败；不要填 0，0 等于不计费、上限永远不会触发）：
# ANCS_MODEL_PRICES_JSON={"deepseek-v4-pro":{"input":"<美元/百万输入token>","output":"<美元/百万输出token>"},"deepseek-flash":{"input":"<…>","output":"<…>"},"elorian-1-agent":{"input":"<…>","output":"<…>"}}

# AI 生成合成内容标识的服务提供者编码（只在面向中国境内公众时需要；当前不面向中国大陆，留空即可，手册 §5.6）
# ANCS_AIGC_PRODUCER_CODE=

# 注册与账号邮件（D-04，手册 §10.4）：首轮内测 = invite（只有收到邀请的邮箱能注册）。invite / open 必须配好发信。
ANCS_SIGNUP_MODE=invite
ANCS_EMAIL_DRIVER=smtp
# 发信服务商的 SMTP 地址（含密码，属于 Secret；465 端口用 smtps://）。例：smtps://用户名:密码@email-smtp.us-east-1.amazonaws.com:465
ANCS_SMTP_URL=
# 发件人（域名要在服务商处完成 SPF / DKIM 验证）
ANCS_EMAIL_FROM="Kinora <no-reply@example.com>"
# 邮件链接指向的网站（缺省 BETTER_AUTH_URL；网站与 API 不同域时才配）
# ANCS_PUBLIC_WEB_URL=https://studio.example.com
# 邮件里显示的产品名（品牌定了再改）
# ANCS_PRODUCT_NAME=Kinora

# 多台 API 时：限流额度存在 Redis 里共用（不配则每个 API 进程各自限流）
# ANCS_RATE_LIMIT_REDIS_URL=redis://redis:6379
